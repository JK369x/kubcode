.DS_Store
.qa/
public/previews/
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
.env
.env.*
!.env.example
*.tsbuildinfo
next-env.d.ts
.impeccable/review/
.impeccable/mocks/

# Local deploy/CLI state (project links, tokens)
.vercel/
supabase/.temp/

# Credentials and key material
*.pem
*.key
*.p12
*.pfx
*.crt
.env.keys

# Archives and large/private media (previews and originals stay local;
# force-add a licensed asset deliberately if one is ever approved)
*.zip
*.tar
*.tar.gz
*.tgz
*.mp4
# Approved homepage preview loops (3.5 s, muted): written only by
# `npm run showcase` from lib/showcase-allowlist.ts, checked by tests/showcase.test.ts.
!public/showcase/*/preview.mp4
*.mov
*.webm
*.mkv
*.wav
*.mp3
*.psd

# Logs and local tool state
*.log
npm-debug.log*
.impeccable/questions/
# Public (non-secret) Supabase root CA bundle used to verify DB TLS in CI
!db/certs/supabase-prod-ca.pem
# TEST ONLY RSA keys for the envelope vectors (never used outside tests).
!tests/fixtures/envelope/test-only-*.pem
