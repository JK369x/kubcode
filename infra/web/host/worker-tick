#!/usr/local/bin/node
// Comment → DM worker tick (docs/design/ig-comment-dm.md §4.8). Run every
// minute by kubcode-worker.timer: one signed POST {} to the publishing
// Function URL's /api/worker, with the same KUBCODE-HMAC-V1 scheme as the web
// app (lib/keys/connect-config.ts). Does nothing until publishing and
// automations are both enabled. Env comes from /etc/kubcode/web.env.
"use strict";
const { createHash, createHmac, randomBytes } = require("node:crypto");

const LAMBDA_URL = /^https:\/\/[a-z0-9]{20,64}\.lambda-url\.ap-southeast-1\.on\.aws\/$/;
const PATH = "/api/worker";

/** The request to send, or null while the feature is off. Throws on bad config. */
function signedRequest(env, timestamp, nonce) {
  if (env.KUBCODE_PUBLISHING_ENABLED !== "true" || env.KUBCODE_AUTOMATIONS_ENABLED !== "true") return null;
  const url = env.KUBCODE_PUBLISHING_URL || "";
  const key = env.KUBCODE_PUBLISHING_HMAC_KEY || "";
  if (!LAMBDA_URL.test(url)) throw new Error("worker-tick: KUBCODE_PUBLISHING_URL is not a Function URL");
  if (Buffer.byteLength(key, "utf8") < 32) throw new Error("worker-tick: KUBCODE_PUBLISHING_HMAC_KEY too short");
  const body = "{}";
  const bodyHash = createHash("sha256").update(body, "utf8").digest("hex");
  const toSign = ["KUBCODE-HMAC-V1", "POST", PATH, String(timestamp), nonce, bodyHash].join("\n");
  return {
    url: new URL(PATH.slice(1), url).href,
    init: {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-kubcode-timestamp": String(timestamp),
        "x-kubcode-nonce": nonce,
        "x-kubcode-signature": createHmac("sha256", key).update(toSign, "utf8").digest("hex"),
      },
      body,
      redirect: "error",
    },
  };
}

async function main() {
  const req = signedRequest(process.env, Math.floor(Date.now() / 1000), randomBytes(16).toString("hex"));
  if (!req) return;
  const res = await fetch(req.url, { ...req.init, signal: AbortSignal.timeout(55_000) });
  const text = await res.text();
  // The answer carries counts and codes only.
  console.log(`worker-tick: ${res.status} ${text.slice(0, 200)}`);
  if (!res.ok) process.exitCode = 1;
}

module.exports = { signedRequest };
if (require.main === module) {
  main().catch((e) => {
    console.error(`worker-tick: ${e && e.message ? e.message : e}`);
    process.exitCode = 1;
  });
}
