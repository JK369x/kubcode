{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jk.local/schemas/shot-plan-v1.json",
  "title": "JK shot plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "title", "scene", "duration", "shots"],
  "properties": {
    "version": {"const": 1}, "title": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^<>\\u0000-\\u001f\\u007f]+$"},
    "scene": {"const": "jk-window"}, "duration": {"type": "number", "minimum": 2, "maximum": 60},
    "shots": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["start", "end", "camera", "effect", "caption"], "properties": {
      "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0},
      "camera": {"enum": ["wide", "hero", "window"]}, "effect": {"enum": ["none", "blink", "latch", "hand"]},
      "caption": {"type": "object", "additionalProperties": false, "required": ["thai", "english", "highlight"], "properties": {
        "thai": {"type": "string", "minLength": 1, "maxLength": 70, "pattern": "^[^<>\\u0000-\\u001f\\u007f]+$"},
        "english": {"type": "string", "minLength": 1, "maxLength": 90, "pattern": "^[^<>\\u0000-\\u001f\\u007f]+$"},
        "highlight": {"type": "string", "minLength": 1}
      }}
    }}},
    "audio": {"type": "object", "additionalProperties": false, "required": ["file", "start", "volume"], "properties": {
      "file": {"type": "string", "pattern": "^assets/[a-zA-Z0-9_-]+\\.(wav|mp3)$"}, "start": {"type": "number", "minimum": 0}, "volume": {"type": "number", "minimum": 0, "maximum": 1}
    }}
  }
}
